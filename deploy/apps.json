{
  "googlesheets": {
    "name": "Google Sheets",
    "kind": "rest_oauth_app",
    "server": "https://sheets.googleapis.com",
    "source": "https://developers.google.com/sheets/api/reference/rest",
    "oauth": {
      "issuer": "https://accounts.google.com",
      "authorization_endpoint": "https://accounts.google.com/o/oauth2/v2/auth",
      "token_endpoint": "https://oauth2.googleapis.com/token",
      "revocation_endpoint": "https://oauth2.googleapis.com/revoke",
      "scopes": [
        "https://www.googleapis.com/auth/spreadsheets"
      ],
      "no_resource_parameter": true,
      "authorization_params": {
        "access_type": "offline",
        "prompt": "consent"
      }
    },
    "token_endpoint_auth_method": "client_secret_post",
    "permission_words": [
      "See, edit, create, and delete all your Google Sheets spreadsheets"
    ],
    "operations": {
      "version": "1",
      "title": "Google Sheets API v4: read a range, add a row",
      "servers": [
        "https://sheets.googleapis.com"
      ],
      "operations": [
        {
          "name": "sheets_get_values",
          "method": "GET",
          "path": "/v4/spreadsheets/{spreadsheetId}/values/{range}",
          "summary": "Read a range of cells",
          "read_only": true,
          "params": [
            {
              "name": "spreadsheetId",
              "in": "path",
              "required": true
            },
            {
              "name": "range",
              "in": "path",
              "required": true
            }
          ],
          "input_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "spreadsheetId": {
                "type": "string"
              },
              "range": {
                "type": "string",
                "description": "A1 notation, for example Sheet1!A1:E6"
              }
            },
            "required": [
              "spreadsheetId",
              "range"
            ]
          }
        },
        {
          "name": "sheets_append_values",
          "method": "POST",
          "path": "/v4/spreadsheets/{spreadsheetId}/values/{range}:append",
          "summary": "Add rows after the last row of a table",
          "params": [
            {
              "name": "spreadsheetId",
              "in": "path",
              "required": true
            },
            {
              "name": "range",
              "in": "path",
              "required": true
            },
            {
              "name": "valueInputOption",
              "in": "query",
              "required": true
            }
          ],
          "body": "fields",
          "input_schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "spreadsheetId": {
                "type": "string"
              },
              "range": {
                "type": "string",
                "description": "The table to add to, in A1 notation, for example Sheet1!A1:E1"
              },
              "valueInputOption": {
                "type": "string",
                "enum": [
                  "RAW"
                ]
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number"
                    ]
                  }
                }
              }
            },
            "required": [
              "spreadsheetId",
              "range",
              "valueInputOption",
              "values"
            ]
          }
        }
      ]
    }
  }
}
